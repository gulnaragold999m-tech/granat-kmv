@echo off
chcp 65001 >nul
title Починить печать — студия Гранат
setlocal

rem ═══════════════════════════════════════════════════════════════
rem  ЗАЧЕМ ЭТОТ ФАЙЛ
rem
rem  22.08.2026 Epson повторял «нет бумаги», хотя бумага была в лотке.
rem  Печать встала, клиентка ждала и ушла без фотографии. Помогло
rem  ровно три действия: очистить очередь, выключить и включить
rem  принтер. Знать их надо заранее — в тот момент искать некогда.
rem
rem  Файл делает первые два действия сам. Третье — руками, кнопкой
rem  на принтере: выключить, досчитать до десяти, включить.
rem
rem  Очередь чистится У ВСЕХ принтеров сразу. Это осознанно: когда
rem  печать встала, разбираться, чьё задание виновато, некогда,
rem  а зависшее задание блокирует все следующие.
rem ═══════════════════════════════════════════════════════════════

rem Служба печати перезапускается только с правами администратора.
rem Без них файл просит их сам, окном Windows «Разрешить изменения?».
net session >nul 2>&1
if errorlevel 1 (
    echo Нужны права администратора. Сейчас Windows спросит разрешение.
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

echo.
echo ============================================================
echo  ШАГ 1. Что сейчас с принтерами и очередью
echo ============================================================
powershell -NoProfile -Command ^
  "Get-Printer | ForEach-Object { $n = @(Get-PrintJob -PrinterName $_.Name -ErrorAction SilentlyContinue).Count; '{0,-30} {1,-14} в очереди: {2}' -f $_.Name, $_.PrinterStatus, $n }"

echo.
echo ============================================================
echo  ШАГ 2. Чищу очередь и перезапускаю службу печати
echo ============================================================
net stop spooler
del /Q /F "%SystemRoot%\System32\spool\PRINTERS\*.*" >nul 2>&1
net start spooler

echo.
echo ============================================================
echo  ШАГ 3. Стало так
echo ============================================================
powershell -NoProfile -Command ^
  "Get-Printer | ForEach-Object { $n = @(Get-PrintJob -PrinterName $_.Name -ErrorAction SilentlyContinue).Count; '{0,-30} {1,-14} в очереди: {2}' -f $_.Name, $_.PrinterStatus, $n }"

echo.
echo ============================================================
echo  ШАГ 4. Теперь руками, на самом принтере
echo ============================================================
echo.
echo   1. Выключите принтер кнопкой.
echo   2. Досчитайте до десяти.
echo   3. Включите.
echo   4. Отправьте фотографию на печать заново.
echo.
echo  Если снова пишет «нет бумаги» — дело не в очереди, а в том,
echo  что в задании стоит НЕ ТОТ размер бумаги или НЕ ТОТ лоток.
echo  Смотрите, что показал ШАГ 5 ниже, и сверьте с тем, что лежит
echo  в переднем лотке. Задний лоток у Epson мы не используем.
echo.
echo ============================================================
echo  ШАГ 5. Какой размер бумаги стоит у принтеров по умолчанию
echo ============================================================
powershell -NoProfile -Command ^
  "Get-Printer | ForEach-Object { $c = Get-PrintConfiguration -PrinterName $_.Name -ErrorAction SilentlyContinue; if ($c) { '{0,-30} бумага по умолчанию: {1}' -f $_.Name, $c.PaperSize } }"

echo.
pause
