@echo off
chcp 65001 >nul
title Установить утреннюю проверку принтеров
setlocal

rem ═══════════════════════════════════════════════════════════════
rem  Ставится ОДИН РАЗ. Дальше ничего делать не надо никогда.
rem
rem  После установки Windows сама проверяет принтеры при каждом
rem  включении компьютера — через две минуты после входа, чтобы
rem  успел подняться Wi-Fi.
rem
rem  Если всё хорошо — не происходит НИЧЕГО. Ни окон, ни звуков,
rem  ни отчётов. Окно появляется только когда печатать нельзя.
rem
rem  Смысл: узнавать о поломке до прихода клиента, ничего для этого
rem  не делая. Владелица, 22.08.2026: «у меня уже сил просто
rem  не хватает».
rem ═══════════════════════════════════════════════════════════════

net session >nul 2>&1
if errorlevel 1 (
    echo Нужны права администратора. Сейчас Windows спросит разрешение.
    powershell -NoProfile -Command "Start-Process -FilePath '%~f0' -Verb RunAs"
    exit /b
)

set "SKRIPT=%~dp0proverka-printerov.ps1"

if not exist "%SKRIPT%" (
    echo.
    echo  ОШИБКА: рядом нет файла proverka-printerov.ps1
    echo  Он должен лежать в той же папке, что и этот файл.
    echo.
    pause
    exit /b
)

echo.
echo  Ставлю проверку в расписание Windows...
echo.

schtasks /Create /TN "Гранат — проверка принтеров" /F /RL HIGHEST /SC ONLOGON /DELAY 0002:00 /TR "powershell.exe -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File \"%SKRIPT%\""

if errorlevel 1 (
    echo.
    echo  Не получилось. Пришлите этот экран в чат — разберёмся.
    echo.
    pause
    exit /b
)

echo.
echo ============================================================
echo  Готово. Больше от вас ничего не требуется.
echo ============================================================
echo.
echo  Включили компьютер — через две минуты проверка проходит сама.
echo  Всё в порядке — вы её не заметите.
echo  Печатать нельзя — выскочит окно с причиной.
echo.
echo  Проверить прямо сейчас, не дожидаясь завтра:
echo.

schtasks /Run /TN "Гранат — проверка принтеров" >nul 2>&1
if errorlevel 1 (
    echo    не удалось запустить вручную, но в расписании она стоит
) else (
    echo    запустил. Если через несколько секунд окна нет — значит
    echo    принтеры в порядке, и это правильное поведение.
)
echo.
echo  Убрать проверку, если надоест:
echo    schtasks /Delete /TN "Гранат — проверка принтеров" /F
echo.
pause
