/* Досье для внешнего рыночного аналитика — файл, который можно целиком
   отдать Perplexity или любому другому советнику по ценам.

   Запуск:  npm run brief
   Результат: brief-analitiku.txt в корне. Открыть, выделить всё,
   вставить в чат аналитику.

   ЗАЧЕМ. Решение владелицы 17.08.2026: «его нам надо оставить в связке
   для аналитики, он как парсер всегда исследует рынок конкурентов».
   Аналитик полезен ровно настолько, насколько знает вводные. Без них
   он подставляет средние по стране, а разброс между Москвой и КМВ
   по печати доходит до двух раз.

   ЧТО СЮДА ПОПАДАЕТ И ЧТО НЕТ. Правило из навыка `kp-i-cena`, файл
   `references/monitoring-cen-rynka.md`: клиентский прайс — да,
   комментарии к нему — нет. Здесь только то, что и так видит
   покупатель: услуги, цены, оборудование, часы, чего мы не делаем.

   Себестоимость, минимумы с обоснованием и рассуждения о том, при каком
   тираже приладка перестаёт влиять, живут в `data/prices.ts` и наружу
   не уходят: это ценовая политика, и конкуренту она дороже самих цен.
   Поэтому файл собирается из `prajsTekstom()` — того же текста, что
   идёт клиенту, — а не из исходника прайса.

   ПОЧЕМУ ГЕНЕРАТОР, А НЕ ГОТОВЫЙ ФАЙЛ. Досье, переписанное руками,
   отстанет от прайса на первой же правке цены — и аналитик начнёт
   сравнивать с рынком цифры, которых у нас уже нет. */

import {
  STUDIYA,
  MAKSIMALNAYA_PLOTNOST,
  NET_V_PRAJSE,
  ISTOCHNIK,
  prajsTekstom,
} from '../data/prices.ts';

import { writeFileSync } from 'node:fs';

const GORODA = [
  'Лермонтов', 'Пятигорск', 'Ессентуки', 'Минеральные Воды',
  'Кисловодск', 'Железноводск', 'Георгиевск',
];

const OBORUDOVANIE = [
  `Плоттер Canon imagePROGRAF TM-340: ширина до 914 мм, рулон 18 м. Чертежи, плакаты, постеры до А0.`,
  `Цветная и чёрно-белая печать до А3.`,
  `Ламинация до А3, плёнка 80–250 мкм.`,
  `Биговка и сгиб, скругление углов, брошюровка.`,
  `Максимальная плотность бумаги — ${MAKSIMALNAYA_PLOTNOST} г/м². Плотнее оборудование не берёт, и обещать этого нельзя.`,
];

const PROSBA = [
  'ЧТО НУЖНО ОТ ТЕБЯ',
  '',
  'Ты рыночный аналитик по полиграфии на Кавказских Минеральных Водах.',
  '',
  'Когда я спрашиваю про цену — находи 3–5 ДЕЙСТВУЮЩИХ прайсов типографий',
  'перечисленных выше городов с ценой ровно на ту позицию, о которой речь.',
  'По каждому давай: название, город, цену, ссылку на прайс и дату,',
  'если она указана.',
  '',
  'Потом говори: моя цена выше рынка, ниже или в рынке — и на сколько.',
  '',
  'Если цены в открытом доступе нет — так и пиши. Не подставляй среднюю',
  'по стране: разброс между Москвой и КМВ по печати доходит до двух раз.',
  '',
  'ЧЕГО НЕ ДЕЛАТЬ',
  '',
  '1. Не придумывать цифры без ссылки. Цифра без источника в прайс не идёт.',
  '2. Не сравнивать с услугами, которых у меня нет — их список выше.',
  '3. Не рассуждать о том, как считает мой калькулятор. Ты видишь прайс,',
  '   а не логику расчёта; в правилах расчёта у тебя нет данных, и догадка',
  '   тут дороже молчания. Нужны правила — попроси, я пришлю нужный кусок.',
  '4. Не советовать цену «чтобы выиграть у конкурента». Мне нужно знать,',
  '   где я в рынке, а решение о цене я принимаю сама.',
];

const s: string[] = [];

s.push('ДОСЬЕ ДЛЯ РЫНОЧНОГО АНАЛИТИКА');
s.push(`Собрано автоматически из прайса. Прайс от ${ISTOCHNIK.data}, принят ${ISTOCHNIK.prinyato}.`);
s.push('');
s.push('КТО МЫ');
s.push(`${STUDIYA.nazvanie} — типография полного цикла: печать и дизайн в одном месте.`);
s.push(STUDIYA.adres);
s.push(`${STUDIYA.telefon} · ${STUDIYA.chasy}`);
s.push(STUDIYA.ohvat);
s.push('');
s.push('РЫНОК, С КОТОРЫМ СРАВНИВАТЬ');
s.push(`Кавказские Минеральные Воды: ${GORODA.join(', ')}.`);
s.push('Не Москва, не Ставрополь, не «в среднем по России».');
s.push('');
s.push('ОБОРУДОВАНИЕ — что физически можем');
for (const o of OBORUDOVANIE) s.push(`  · ${o}`);
s.push('');
s.push('ЧЕГО У НАС НЕТ — не сравнивай нас по этим услугам');
for (const n of NET_V_PRAJSE) s.push(`  · ${n}`);
s.push('  · съёмки на документы: печатаем готовый файл и собираем лист из фото клиента, но не снимаем');
s.push('');
s.push('─'.repeat(66));
s.push('');
s.push('ПРАЙС — тот же, что видит клиент');
s.push('');
s.push(prajsTekstom());
s.push('');
s.push('─'.repeat(66));
s.push('');
s.push(...PROSBA);

writeFileSync(new URL('../brief-analitiku.txt', import.meta.url), s.join('\n'), 'utf8');
console.log('Готово: brief-analitiku.txt — открыть, выделить всё, вставить аналитику.');
