/* Проверка текстов объявлений и исследований рынка перед публикацией.

   Запуск:  npm run proverka tasks/market-research/2026-08-18-tema.md

   ЗАЧЕМ. Тексты для карточек приходят снаружи — от внешнего аналитика,
   из чужого разбора, из соседней беседы. Они звучат правдоподобно
   и содержат ошибки, которые видно только по прайсу. 17.08.2026
   внешний аналитик назвал цену биговки 300 ₽ за операцию — это минимум
   за весь заказ, ошибка втрое. Попади такая цифра в объявление, клиент
   пришёл бы за одной ценой, а услышал другую.

   ЧТО ЭТО НЕ ДЕЛАЕТ. Не запрещает публикацию и не правит текст. Печатает
   список мест, которые надо посмотреть глазами. Решение за человеком:
   скрипт не знает контекста и легко примет верную фразу за ошибку.

   ПРАВИЛО РАЗВИТИЯ. Проверка ловит только то, что ей велели смотреть.
   Нашли в тексте ошибку, которую скрипт пропустил, — добавьте правило
   сюда, иначе она вернётся. Так уже было со сроками: цены на макетах
   сверялись с 11.08, а сроки не сверялись и разъехались за неделю. */

import {
  NET_V_PRAJSE,
  OPLATA,
  MAKSIMALNAYA_PLOTNOST,
  AKCII,
  prajsTekstom,
} from '../data/prices.ts';

import { readFileSync } from 'node:fs';

const put = process.argv[2];
if (!put) {
  console.error('Укажите файл: npm run proverka tasks/market-research/файл.md');
  process.exit(1);
}

let tekst: string;
try {
  tekst = readFileSync(put, 'utf8');
} catch {
  console.error(`Не читается файл: ${put}`);
  process.exit(1);
}

const nizhnij = tekst.toLowerCase();

interface Nahodka {
  urgh: 'СТОП' | 'ПРОВЕРИТЬ';
  chto: string;
  pochemu: string;
}

const nahodki: Nahodka[] = [];

/* ── 1. Услуги, которых у нас нет ────────────────────────────────
   Ищем по корню слова: «тиснение», «тиснением», «тиснения» — одно и то же.
   Корень берём как первые семь букв значимого слова из NET_V_PRAJSE. */

const KORNI_NET: { koren: string; polnoe: string }[] = [
  { koren: 'тиснен', polnoe: 'тиснение штампом под давлением' },
  // «фольгирование» НЕ запрещено: это лазерная печать плюс фольга через
  // ламинатор, услуга у нас есть с 17.08.2026. Запрещено «тиснение» —
  // оно делается штампом, которого у нас нет. Слова похожие, услуги
  // разные, и путать их в объявлении нельзя.
  { koren: 'конгрев', polnoe: 'конгрев' },
  { koren: 'уф-лак', polnoe: 'УФ-лак' },
  { koren: 'контурн', polnoe: 'контурная резка наклеек' },
  { koren: 'фигурны', polnoe: 'фигурные стикеры' },
  { koren: 'фирменн', polnoe: 'фирменный стиль' },
  { koren: 'логотип', polnoe: 'разработка логотипа' },
  { koren: 'офсет', polnoe: 'офсетная печать' },
  { koren: 'съёмк', polnoe: 'съёмка на документы' },
  { koren: 'съемк', polnoe: 'съёмка на документы' },
  { koren: 'фотосесс', polnoe: 'фотосессия' },
];

for (const { koren, polnoe } of KORNI_NET) {
  if (nizhnij.includes(koren)) {
    nahodki.push({
      urgh: 'СТОП',
      chto: `упомянуто «${koren}…» — похоже на «${polnoe}»`,
      pochemu: 'этой услуги у нас нет, обещать нельзя',
    });
  }
}

/* ── 2. Цифры, которые в прайсе УЖЕ поменялись ───────────────────
   Каждая из них когда-то была верной и поэтому всплывает в чужих
   текстах и в старых макетах. */

const USTAREVSHEE: { chto: RegExp; pochemu: string }[] = [
  {
    chto: /предоплат[а-яё]*\s*[—:-]?\s*50\s*%|50\s*%\s*предоплат/i,
    pochemu: `предоплата теперь ${OPLATA.predoplataProcent}%, решение владелицы 17.08.2026`,
  },
  {
    chto: /\+\s*50\s*%|плюс\s*50\s*%/i,
    pochemu: 'срочность +30%, а не +50%. Формулировка: «сегодня, день в день — +30%»',
  },
  {
    chto: /\b(300|350)\s*г\s*\/?\s*м/i,
    pochemu: `принтер берёт до ${MAKSIMALNAYA_PLOTNOST} г/м². 300 и 350 сняты 17.08.2026`,
  },
  {
    chto: /от\s*225\s*₽/i,
    pochemu: 'цена «от 225 ₽» была посчитана по наценке +50%. Сейчас срочная грамота — 195 ₽',
  },
  {
    chto: /telegram|телеграм/i,
    pochemu: 'Telegram снят с сайта студии 15.08.2026 — проверьте, уместен ли он здесь',
  },
];

for (const u of USTAREVSHEE) {
  const m = tekst.match(u.chto);
  if (m) {
    nahodki.push({ urgh: 'СТОП', chto: `«${m[0].trim()}»`, pochemu: u.pochemu });
  }
}

/* ── 3. Обещания, которые никто не может выполнить ─────────────────
   ВНИМАНИЕ на регулярки: в JavaScript `\w` — это [A-Za-z0-9_], кириллицу
   он НЕ матчит, и `\b` считает границы по нему же. Поэтому здесь везде
   явные диапазоны [а-яё], а не `\w`. 17.08.2026 первая версия скрипта
   молча пропускала «Предоплата 50%» и «Гарантируем первое место» именно
   из-за этого: правило есть, а не срабатывает. */

const OBESHCHANIYA: { chto: RegExp; pochemu: string }[] = [
  { chto: /перв[а-яё]+ (место|строчк)|топ-?\d|в топе/i, pochemu: 'позициями в поиске не управляет никто' },
  { chto: /штраф[а-яё]*\s*до\s*[\d\s ]+/i, pochemu: 'пугать суммой штрафа нельзя — читается как развод' },
  { chto: /гарантиру[а-яё]+/i, pochemu: 'проверьте, что именно гарантируем и чем это подтверждено' },
  { chto: /за\s*\d+\s*(минут|час)[а-яё]*(?![\s\S]*очеред)/i, pochemu: 'срок в минутах и часах прайсом не предусмотрен, кроме фото на документы' },
];

for (const o of OBESHCHANIYA) {
  const m = tekst.match(o.chto);
  if (m) {
    nahodki.push({ urgh: 'ПРОВЕРИТЬ', chto: `«${m[0].trim()}»`, pochemu: o.pochemu });
  }
}

/* ── 4. Цены, которых нет в прайсе ────────────────────────────────
   Собираем все числа перед знаком рубля и ищем каждое в текстовом
   прайсе. Не нашли — это не обязательно ошибка: цена могла быть суммой
   или ценой конкурента. Поэтому «ПРОВЕРИТЬ», а не «СТОП». */

const prajs = prajsTekstom();
const cenyPrajsa = new Set(
  (prajs.match(/\d[\d\s ]*(?=\s*₽)/g) || []).map((c) => c.replace(/[\s ]/g, '')),
);

const cenyTeksta = [...new Set((tekst.match(/\d[\d\s ]*(?=\s*₽)/g) || [])
  .map((c) => c.replace(/[\s ]/g, '')))];

const chuzhie = cenyTeksta.filter((c) => !cenyPrajsa.has(c));
if (chuzhie.length) {
  nahodki.push({
    urgh: 'ПРОВЕРИТЬ',
    chto: `цены не из прайса: ${chuzhie.join(', ')} ₽`,
    pochemu: 'либо это сумма заказа или цена конкурента, либо цифра выдумана',
  });
}

/* ── 5. Скидка без действующей акции ─────────────────────────────── */

if (/скидк|акци|−\s*\d+\s*%|-\s*\d+\s*%/i.test(tekst)) {
  const est = AKCII.some((a) => a.aktivna);
  if (!est) {
    nahodki.push({
      urgh: 'СТОП',
      chto: 'упомянута скидка или акция',
      pochemu: 'в data/prices.ts нет ни одной активной акции — бот о ней не знает и назовёт полную цену',
    });
  }
}

/* ── 6. Призыв к действию ────────────────────────────────────────── */

const CTA = /позвоните|напишите|заходите|приходите|пришлите|опишите|оставьте|откройте|посчитаем при вас/i;
if (!CTA.test(tekst)) {
  nahodki.push({
    urgh: 'ПРОВЕРИТЬ',
    chto: 'не нашёл призыва к действию',
    pochemu: 'объявление без CTA не работает: человек прочитал и закрыл',
  });
}

/* ── Вывод ───────────────────────────────────────────────────────── */

console.log(`\nПроверка: ${put}\n`);

if (!nahodki.length) {
  console.log('Чисто. Ничего из того, что скрипт умеет ловить, не нашлось.');
  console.log('Это не значит «можно публиковать» — глазами всё равно прочитать.\n');
  process.exit(0);
}

const stop = nahodki.filter((n) => n.urgh === 'СТОП');
const proverit = nahodki.filter((n) => n.urgh === 'ПРОВЕРИТЬ');

for (const [zagolovok, spisok] of [['СТОП', stop], ['ПРОВЕРИТЬ', proverit]] as const) {
  if (!spisok.length) continue;
  console.log(`${zagolovok} — ${spisok.length}:`);
  for (const n of spisok) {
    console.log(`  · ${n.chto}`);
    console.log(`    ${n.pochemu}`);
  }
  console.log('');
}

console.log('Публикацию скрипт не запрещает — решает человек.\n');
